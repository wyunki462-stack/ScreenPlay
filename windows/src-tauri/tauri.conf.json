{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenPlay",
  "version": "1.3.2",
  "identifier": "com.screenplay.desktop",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "url": "index.html",
        "title": "ScreenPlay",
        "width": 520,
        "height": 340,
        "minWidth": 520,
        "minHeight": 340,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "center": true,
        "decorations": true,
        "visible": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/": "resources/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}