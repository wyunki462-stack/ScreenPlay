# =============================================================================
# ScreenPlay — 独立设备部署配置
#
# 用法：
#   1) 把本文件复制为 .env（放在 docker-compose.deploy.yml 同级目录）
#        cp .env.deploy.example .env
#   2) 改下面的 MEDIA_HOST_DIR（**必须**，且要指向真实存在的目录）
#   3) docker compose -f docker-compose.deploy.yml up -d
#
# 只需要填带 ★ 的项；其余留空即可正常启动。
# =============================================================================

# --- ★ 媒体目录（最重要的一项）---------------------------------------------
# 本机上存放**游戏截图/视频**的根目录，会以只读方式挂进容器的 /media。
# 目录层级不限，程序自己会识别哪些文件夹对应哪个游戏。
#
#   Linux / NAS : /volume1/photos/games   或  /mnt/media/games
#   Windows     : D:/Games/Shots          （注意用正斜杠，或写成 D:\\Games\\Shots）
#   macOS       : /Users/你的用户名/Pictures/games
#
# ⚠️ 必须真实存在，否则扫描不到任何游戏（容器仍能启动，但库是空的）
MEDIA_HOST_DIR=./media

# --- 访问端口 ----------------------------------------------------------------
# 浏览器打开 http://<这台设备的IP>:3001
PORT=3001

# --- 登录认证 ----------------------------------------------------------------
# local = 用应用内账户（本文件默认值，最省事）
# system = 用本机 Linux 系统账户（需额外挂载 /etc/{passwd,shadow,group}，
#          见 docker-compose.deploy.yml 末尾注释）
AUTH_MODE=local

# 可选：指定 admin 初始密码。留空则首次启动时**随机生成并打印在日志里**：
#   docker compose -f docker-compose.deploy.yml logs screenplay | grep -i admin
AUTH_ADMIN_PASSWORD=

# 可选：只允许这些账户登录（逗号分隔）。留空 = 允许全部普通账户。
AUTH_ALLOWED_USERS=

# 应急开关：设为 1 可临时跳过登录校验（忘记密码时用，用完记得改回）
AUTH_DISABLED=

# --- ★ 元数据源（不填也能跑，但部分刮削功能不可用）---------------------------
# RAWG 是最主要的元数据源，强烈建议填：https://rawg.io/apidocs 免费申请
RAWG_API_KEY=

# IGDB（Twitch）— 可选
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Steam Web API — 可选，用于成就
STEAM_API_KEY=
# SteamDB — 可选，用于历史最低价
STEAMDB_KEY=

# --- 运行时代理（与构建期代理完全独立）--------------------------------------
# Metacritic 媒体评价、RAWG 等数据源在部分网络下需要能出境访问。
# 推荐写法（host.docker.internal 已由 compose 指向宿主机）：
#   RAWG_PROXY=http://host.docker.internal:7890
#
# ⚠️ 不要填 127.0.0.1 —— 在容器里那指容器自己。
RAWG_PROXY=
# 标准写法，仅在 RAWG_PROXY 为空时生效
RUNTIME_HTTP_PROXY=
RUNTIME_HTTPS_PROXY=

# 图片(封面/截图)抓取顺序：proxy,direct | direct,proxy | direct
# 留空 = 用程序默认。局域网/私有地址永远直连，不受此项影响。
IMAGE_FETCH_ORDER=

# --- 构建期代理（仅「方式 A 本机构建镜像」时需要）----------------------------
# 构建容器有独立网络，必须显式注入，且**不能填 127.0.0.1**。
# 本机有代理（如 7890）时可填：http://host.docker.internal:7890
# 更省事的做法是直接跑 bash scripts/docker-build.sh（自动探测并注入）。
SCREENPLAY_BUILD_PROXY=

# --- 其他可选 ----------------------------------------------------------------
# 允许的跨域来源，默认 * 即可
CORS_ORIGINS=*
# 抓取限速（毫秒），不要低于 1000
CRAWLER_MIN_INTERVAL_MS=1200
# 缩略图
THUMBNAIL_WIDTH=480
THUMBNAIL_QUALITY=80
# 启动期存量数据修复（海报轮播下限补足 / 首次补全通关时长）。设为 0 关闭。
MAINTENANCE_ON_BOOT=