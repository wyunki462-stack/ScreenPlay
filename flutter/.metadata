version:
  revision: "0000000000000000000000000000000000000000"
  channel: "stable"

project_type: app

# Tracks metadata for the flutter migrate command
migration:
  platforms:
    - platform: root
      create_revision: "0000000000000000000000000000000000000000"
      base_revision: "0000000000000000000000000000000000000000"
    - platform: android
      create_revision: "0000000000000000000000000000000000000000"
      base_revision: "0000000000000000000000000000000000000000"
    - platform: windows
      create_revision: "0000000000000000000000000000000000000000"
      base_revision: "0000000000000000000000000000000000000000"

  # User provided section
  android_device_info:
    min_sdk_version: 28