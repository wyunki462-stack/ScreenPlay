# 由 run.sh 现场用 esbuild 打包生成（会内联整个后端源码，单文件 1.5–5MB），
# 属于构建产物而非源码 —— 不入库。
# 生成入口：
#   node/…/esbuild "$ESB" .entry-contract.ts --bundle … --outfile=contract.cjs
#   node/…/esbuild "$ESB" .entry-trophy.ts   --bundle … --outfile=trophy.cjs
*.cjs
*.css

# 打包用的临时入口文件（同样由 run.sh 生成）
.entry-*.ts
.entry-*.js