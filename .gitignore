# dependencies
node_modules/
.pnpm-store/

# build output
dist/
# 镜像包输出目录（scripts/package-image.sh 的 OUT_DIR），单个 .tar.gz 可达 500MB+
dist-image/
# 锚定到仓库根：原来的 `build/` 会匹配**任意层级**的 build 目录，把
# scripts/build/（构建期脚本的源码，必须进版本库）也一并忽略了 —— 后果是别人
# 克隆后 scripts/build/ 为空，Dockerfile 的 COPY 直接失败，而本地因为文件还在
# 完全看不出来。下面那条 ! 是显式放行，避免以后再被别的规则误伤。
/build/
!/scripts/build/
*.tsbuildinfo
web/dist/

# environment / secrets
.env
.env.local
*.local

# data / media caches (mount points)
data/
cache/
thumbnails/
# media/ 是 MEDIA_HOST_DIR 的默认挂载点（.env 里指向真实相册目录），里面是用户的
# 私人截图/视频。此前没排除它，靠的是"目录为空所以 git 不跟踪"这一巧合 —— 一旦
# 有人往里放一个文件就会被跟踪并上传。显式排除掉，别依赖巧合。
media/
*.db
*.db-journal
*.db-wal
*.db-shm

# logs
*.log
npm-debug.log*
logs/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Flutter
flutter/**/build/
flutter/**/.dart_tool/
flutter/**/.flutter-plugins*
flutter/**/.packages
flutter/**/android/.gradle/
flutter/**/*.apk
flutter/**/*.exe
flutter/**/windows/flutter/

# ---------------------------------------------------------------------------
# 开发期临时目录与产物（本仓库的验证脚本会在仓库根下建 .tmp-* 工作区）
# 这些目录里可能有数据库副本、夹具媒体、浏览器截图 —— 一律不进仓库。
# ---------------------------------------------------------------------------
.tmp*/
.tmp-*/
shots/
*.tmp

# 本地备份（例如移出的个人配置），绝不提交
*.backup
*-backup/
.nas-mihomo-split-backup*

# Playwright / Chromium 本地下载
.pw/

# 镜像导出文件（几百 MB，绝不入库）
screenplay-image*.tar.gz
*.tar.gz
